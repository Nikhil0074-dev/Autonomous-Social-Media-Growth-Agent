# Copy to .env and edit. All values are optional.
SGA_LLM_PROVIDER=ollama        # ollama | mock  (mock = fake text, for testing without a model)
SGA_OLLAMA_URL=http://127.0.0.1:11434
SGA_OLLAMA_MODEL=llama3.2
SGA_LLM_TIMEOUT=300            # seconds per model call
SGA_MAX_RETRIES=2              # retries when the model returns bad JSON
SGA_DATA_DIR=                  # empty = ./data
SGA_BRAND_NAME=My Brand
SGA_FONT_PATH=                 # optional .ttf file for graphics
SGA_ALLOW_URL_FETCH=1          # 0 = never download web pages
